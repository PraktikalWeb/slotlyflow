{
  "name": "slotlyflow",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @slotlyflow/database db:generate",
    "db:migrate": "pnpm --filter @slotlyflow/database db:migrate",
    "db:test": "pnpm --filter @slotlyflow/database test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.2",
    "@types/node": "^22.15.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  }
}

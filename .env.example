# Copy this file to .env.local and manually supply every placeholder value.
# This file is server-only. Never place these values in apps/web environment files.
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5433/<database>
GOOGLE_OIDC_CLIENT_ID=<google-client-id>
GOOGLE_OIDC_CLIENT_SECRET=<google-client-secret>
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3001/auth/google/callback
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
HOST=127.0.0.1
PORT=3001

# Local transactional-email sink. Mailpit exposes SMTP on 127.0.0.1:1025 and its inbox at http://localhost:8025.
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=no-reply@slotlyflow.local
EMAIL_FROM_NAME=SlotlyFlow
# SMTP_USER=
# SMTP_PASSWORD=

# Required only when managing the local PostgreSQL container through Docker Compose.
SLOTLYFLOW_POSTGRES_DB=<database>
SLOTLYFLOW_POSTGRES_USER=<user>
SLOTLYFLOW_POSTGRES_PASSWORD=<password>

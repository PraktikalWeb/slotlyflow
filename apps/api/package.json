{
  "name": "@slotlyflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @slotlyflow/config build && pnpm --filter @slotlyflow/contracts build && pnpm --filter @slotlyflow/security build && pnpm --filter @slotlyflow/database build && node --env-file-if-exists=../../.env.local --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-test-environment.mjs pnpm exec vitest run",
    "platform-admin:grant": "node --env-file-if-exists=../../.env.local --import tsx src/platform-admin/cli/grant-platform-admin.ts",
    "bot:provision-handover-test": "node --env-file-if-exists=../../.env.local --import tsx src/bots/cli/provision-handover-test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "11.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@slotlyflow/config": "workspace:*",
    "@slotlyflow/contracts": "workspace:*",
    "@slotlyflow/database": "workspace:*",
    "@slotlyflow/security": "workspace:*",
    "argon2": "0.45.1",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "5.11.3",
    "nodemailer": "9.0.5",
    "openid-client": "6.8.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "tsx": "^4.19.3",
    "vitest": "^3.1.3"
  }
}
